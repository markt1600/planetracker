# Vercel Blob store token. Created automatically when you connect a Blob store to the project.
# Holds the collection, Ethan's own photos and the price history.
BLOB_READ_WRITE_TOKEN=

# Anthropic API key for "Spot it" (identify a plane from a photo, using Claude Opus 5.5).
ANTHROPIC_API_KEY=

# Optional but recommended: a passcode required before anyone can add, edit or delete planes,
# upload photos or use photo identification. Viewing stays open.
SITE_PASSCODE=

# Optional: protects the daily price-check endpoint. Vercel sends it automatically to cron jobs.
CRON_SECRET=

# Optional display settings.
OWNER_NAME=Ethan
DEFAULT_CURRENCY=SGD
